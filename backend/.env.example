# App Configuration
APP_NAME="ResponSync Backend"
ENVIRONMENT="development"
DEBUG=true

# Database Configuration (PostgreSQL / Supabase with PostGIS)
# For Async SQLAlchemy: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/responsync"

# Supabase Credentials
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_KEY="your-supabase-anon-key"

# External APIs
OPENWEATHER_API_KEY="your-openweather-api-key"
MAPBOX_API_KEY="your-mapbox-api-key"

# AI / LLM Integration
GEMINI_API_KEY="your-gemini-api-key"

# Security & Auth
JWT_SECRET="your-super-secret-jwt-key-min-32-chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Cache / Queue (Optional)
REDIS_URL="redis://localhost:6379/0"
